{
  "name": "linnstrument-custom-mode",
  "version": "0.1.0",
  "description": "Browser-based LinnStrument custom mode prototype with scale layouts.",
  "packageManager": "bun@1.3.8",
  "main": "index.js",
  "scripts": {
    "build": "bash ./bin/updateLibs.sh",
    "test": "node --check web/src/main.js && node --check web/src/grid.js && node --check web/src/config.js && node --check web/src/log.js",
    "deploy": "gh-pages -d ./web",
    "prestart": "bun run build",
    "start": "serve ./web"
  },
  "author": "Simon Heimler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fannon/linnstrument-custom-mode.git"
  },
  "bugs": {
    "url": "https://github.com/Fannon/linnstrument-custom-mode/issues"
  },
  "homepage": "https://github.com/Fannon/linnstrument-custom-mode#readme",
  "dependencies": {
    "bootstrap": "^5.3.3",
    "serve": "^14.2.5",
    "webmidi": "^3.1.12"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
