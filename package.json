{
  "name": "linnstrument-custom-mode",
  "version": "0.1.0",
  "description": "Browser-based LinnStrument custom mode with scale layouts.",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "build": "bun ./bin/updateLibs.js",
    "lint": "biome check --formatter-enabled=false --assist-enabled=false .",
    "format:check": "biome check --linter-enabled=false --assist-enabled=false .",
    "test:unit": "bun test test",
    "test": "bun run test:unit",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:coverage": "bun run build && playwright test e2e/main-coverage.spec.js",
    "verify": "bun run lint && bun run test && bun run build",
    "deploy": "gh-pages -d ./web",
    "prestart": "bun run build",
    "start": "serve ./web"
  },
  "author": "Simon Heimler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fannon/linnstrument-custom-mode.git"
  },
  "bugs": {
    "url": "https://github.com/Fannon/linnstrument-custom-mode/issues"
  },
  "homepage": "https://github.com/Fannon/linnstrument-custom-mode#readme",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "serve": "^14.2.5",
    "webmidi": "^3.1.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@playwright/test": "^1.58.2",
    "gh-pages": "^6.3.0"
  }
}
